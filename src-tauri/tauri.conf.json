{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lookover",
  "version": "0.2.0",
  "identifier": "com.fixjp.lookover",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lookover",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 320,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "jfif",
          "webp",
          "gif",
          "bmp",
          "avif",
          "ico",
          "svg"
        ],
        "name": "Image",
        "description": "画像ファイル",
        "role": "Viewer"
      }
    ]
  }
}
