+// ホイールの向き。縦の動きの方が大きければ縦、そうでなければ横。動いていなければ null。
+export function wheelDir(e) {
+  const x = e.deltaX || 0, y = e.deltaY || 0;
+  if (!x && !y) return null;
+  if (Math.abs(y) >= Math.abs(x)) return y < 0 ? 'WheelUp' : 'WheelDown';
+  return x < 0 ? 'WheelLeft' : 'WheelRight';
